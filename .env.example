# ============================================
# INVIFTY STUDIO — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# Los encuentras en: Supabase Dashboard → Project Settings → API
# ============================================

# URL de tu proyecto de Supabase (ej: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (SECRETA — solo servidor, nunca la compartas)
SUPABASE_SERVICE_ROLE_KEY=

# URL donde vive este sistema (para generar los links de formularios)
# En local: http://localhost:3000 · En producción: https://studio.invifty.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Notificaciones por email (opcional) ----------
# API key de resend.com (gratis hasta 3,000 emails/mes).
# Sin estas variables el sistema funciona igual, solo no envía avisos.
RESEND_API_KEY=

# Correo(s) del equipo que reciben el aviso cuando un cliente
# completa su formulario. Varios separados por coma.
NOTIFICACIONES_EMAIL=

# Remitente (opcional). Por defecto usa onboarding@resend.dev, que solo
# puede enviar al correo dueño de la cuenta Resend. Con dominio verificado:
# NOTIFICACIONES_REMITENTE="Invifty Studio <studio@invifty.com>"
NOTIFICACIONES_REMITENTE=
