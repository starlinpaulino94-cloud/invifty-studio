# ============================================
# INVIFTY STUDIO — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# Los encuentras en: Supabase Dashboard → Project Settings → API
# ============================================

# URL de tu proyecto de Supabase (ej: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta (SECRETA — solo servidor, nunca la compartas).
# Acepta cualquiera de los dos nombres: el clásico "service_role"
# (SUPABASE_SERVICE_ROLE_KEY) o el nuevo "secret key" (SUPABASE_SECRET_KEY).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# URL donde vive este sistema (para generar los links de formularios)
# En local: http://localhost:3000 · En producción: https://studio.invifty.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Notificaciones por email (opcional) ----------
# API key de resend.com (gratis hasta 3,000 emails/mes).
# Sin estas variables el sistema funciona igual, solo no envía avisos.
RESEND_API_KEY=

# Correo(s) del equipo que reciben el aviso cuando un cliente
# completa su formulario. Varios separados por coma.
NOTIFICACIONES_EMAIL=

# Remitente (opcional). Por defecto usa onboarding@resend.dev, que solo
# puede enviar al correo dueño de la cuenta Resend. Con dominio verificado:
# NOTIFICACIONES_REMITENTE="Invifty Studio <studio@invifty.com>"
NOTIFICACIONES_REMITENTE=

# ---------- Repaso diario de vencimientos ----------
# Contraseña que protege /api/cron/vencimientos, la tarea que marca las
# invitaciones vencidas y avisa de las que están por vencer.
# Ponla en Vercel (una cadena larga al azar) y Vercel la enviará sola en
# cada ejecución programada. SIN esta variable la ruta queda cerrada y el
# repaso no corre: es a propósito, para que nadie pueda dispararla.
CRON_SECRET=

# ---------- IA creativa (conceptos de diseño) ----------
# Quién propone los conceptos en el editor: "mock" (por defecto: generador
# local determinista, sin coste), "anthropic" (Claude; exige IA_API_KEY) u
# "off" (apagado). El pipeline completo funciona en mock sin configurar nada.
IA_PROVEEDOR=
# Clave de la API de Anthropic (console.anthropic.com). Solo con IA_PROVEEDOR=anthropic.
IA_API_KEY=
